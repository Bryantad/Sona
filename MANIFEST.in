include LICENSE
recursive-include sona *.lark
recursive-include stdlib *.smod *.py
prune .github
prune .vscode
prune .venv
prune build
prune dist
prune dist-pypi
prune dist-pypi-*
prune dist-readme-check
prune docs
include examples/hello.sona examples/variables_math.sona examples/functions.sona
include examples/control_flow.sona examples/stdlib_math.sona examples/stdlib_string.sona
include examples/stdlib_json.sona examples/stdlib_fs.sona examples/calculator.sona
recursive-include examples/learning *.sona
prune extensions
prune htmlcov
prune planning
prune reports
prune tests
prune vscode-extension
global-exclude *.py[cod] __pycache__ .coverage .coverage.* coverage.xml *.vsix *.zip *.log *.bak *.tmp *~
