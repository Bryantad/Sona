{
  "name": "sona-ai-native-programming",
  "displayName": "Sona: Cognitive Developer Experience",
  "description": "AI-native programming with Sona diagnostics, a Proof Mode Explorer, a read-only Runtime view, Guardian workflows, and a preview Sona AI Console.",
  "version": "0.15.6",
  "publisher": "Waycoreinc",
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.91.0",
    "node": ">=20.18.1 <21"
  },
  "categories": [
    "Programming Languages",
    "AI",
    "Other"
  ],
  "keywords": [
    "sona",
    "ai",
    "programming",
    "cognitive",
    "cognitive-programming-language",
    "cognitive programming language",
    "guardian",
    "proof",
    "release-evidence",
    "guide",
    "learning"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Bryantad/Sona.git"
  },
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "sona",
        "aliases": [
          "Sona",
          "sona"
        ],
        "extensions": [
          ".sona",
          ".smod"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sona",
          "title": "Sona",
          "icon": "assets/icon.png"
        }
      ]
    },
    "views": {
      "sona": [
        {
          "id": "sona.proofModeExplorer",
          "name": "Proof Mode"
        },
        {
          "id": "sona.runtimeView",
          "name": "Sona Runtime"
        },
        {
          "id": "sona.aiConsole",
          "name": "Sona AI Console",
          "type": "webview"
        }
      ]
    },
    "commands": [
      { "command": "sona.runtime.refresh", "title": "Refresh Sona Runtime", "category": "Sona Runtime" },
      { "command": "sona.guide.explainDiagnostic", "title": "Explain Diagnostic (Offline)", "category": "Sona Guide" },
      { "command": "sona.guide.explainSelection", "title": "Explain Selection (Offline)", "category": "Sona Guide" },
      { "command": "sona.guide.focus", "title": "Show Focused Diagnostics", "category": "Sona Guide" },
      { "command": "sona.guide.setup", "title": "Choose Guidance Detail", "category": "Sona Guide" },
      { "command": "sona.guide.explainProof", "title": "Explain Proof Mode Receipt (Offline)", "category": "Sona Guide" },
      { "command": "sona.guide.explainGuardian", "title": "Explain Guardian State (Offline)", "category": "Sona Guide" },
      {
        "command": "sona.aiConsole.focus",
        "title": "Sona: Open AI Console",
        "category": "Sona",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "sona.aiConsole.clear",
        "title": "Sona: Clear AI Console",
        "category": "Sona",
        "icon": "$(clear-all)"
      },
      {
        "command": "sona.aiConsole.selectAgent",
        "title": "Sona: Select AI Agent",
        "category": "Sona",
        "icon": "$(account)"
      },
      {
        "command": "sona.welcome",
        "title": "Welcome & Setup",
        "category": "Sona",
        "icon": "$(home)"
      },
      {
        "command": "sona.aiPlanSelection",
        "title": "Sona: AI Plan Selection",
        "category": "Sona",
        "icon": "$(list-unordered)"
      },
      {
        "command": "sona.aiReviewSelection",
        "title": "Sona: AI Review Selection",
        "category": "Sona",
        "icon": "$(search)"
      },
      {
        "command": "sona.setup.azure",
        "title": "Setup Azure OpenAI",
        "category": "Sona",
        "icon": "$(cloud)"
      },
      {
        "command": "sona.setup.manual",
        "title": "Manual AI Setup",
        "category": "Sona",
        "icon": "$(gear)"
      },
      {
        "command": "sona.selectUserProfile",
        "title": "Select Display Preference",
        "category": "Sona",
        "icon": "$(person)"
      },
      {
        "command": "sona.run",
        "title": "Run Sona File",
        "category": "Sona",
        "icon": "$(play)"
      },
      {
        "command": "sona.proofMode.run",
        "title": "Run with Proof Mode",
        "category": "Sona",
        "icon": "$(shield)"
      },
      {
        "command": "sona.proofMode.verifyReceipt",
        "title": "Verify Receipt",
        "category": "Sona",
        "icon": "$(verified-filled)"
      },
      {
        "command": "sona.proofMode.inspectReceipt",
        "title": "Inspect Receipt",
        "category": "Sona",
        "icon": "$(eye)"
      },
      {
        "command": "sona.proofMode.openReceipt",
        "title": "Open Receipt",
        "category": "Sona",
        "icon": "$(json)"
      },
      {
        "command": "sona.proofMode.refresh",
        "title": "Refresh Proof Mode",
        "category": "Sona",
        "icon": "$(refresh)"
      },
      {
        "command": "sona.proofMode.explainWithGuardian",
        "title": "Explain with Guardian",
        "category": "Sona",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "sona.transpile",
        "title": "Transpile to Python",
        "category": "Sona",
        "icon": "$(arrow-right)"
      },
      {
        "command": "sona.repl",
        "title": "Start REPL",
        "category": "Sona",
        "icon": "$(terminal)"
      },
      {
        "command": "sona.check",
        "title": "Check Syntax",
        "category": "Sona",
        "icon": "$(check)"
      },
      {
        "command": "sona.format",
        "title": "Format Code",
        "category": "Sona",
        "icon": "$(word-wrap)"
      },
      {
        "command": "sona.explain",
        "title": "Explain Code",
        "category": "Sona",
        "icon": "$(question)"
      },
      {
        "command": "sona.suggest",
        "title": "Get AI Suggestions",
        "category": "Sona",
        "icon": "$(lightbulb)"
      },
      {
        "command": "sona.profile",
        "title": "Profile Performance",
        "category": "Sona",
        "icon": "$(graph)"
      },
      {
        "command": "sona.benchmark",
        "title": "Benchmark Code",
        "category": "Sona",
        "icon": "$(dashboard)"
      },
      {
        "command": "sona.info",
        "title": "Show System Info",
        "category": "Sona",
        "icon": "$(info)"
      },
      {
        "command": "sona.help",
        "title": "Help & Commands",
        "category": "Sona",
        "icon": "$(question)"
      },
      {
        "command": "sona.checkAIConnection",
        "title": "Check AI Connection",
        "category": "Sona",
        "icon": "$(pulse)"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "sona.guide.explainDiagnostic", "when": "editorLangId == sona" },
        { "command": "sona.guide.explainSelection", "when": "editorLangId == sona && editorHasSelection" },
        { "command": "sona.guide.focus", "when": "editorLangId == sona" },
        {
          "command": "sona.aiConsole.focus",
          "when": "true"
        },
        {
          "command": "sona.aiConsole.clear",
          "when": "true"
        },
        {
          "command": "sona.aiConsole.selectAgent",
          "when": "true"
        },
        {
          "command": "sona.welcome",
          "when": "true"
        },
        {
          "command": "sona.setup.azure",
          "when": "true"
        },
        {
          "command": "sona.setup.manual",
          "when": "true"
        },
        {
          "command": "sona.selectUserProfile",
          "when": "true"
        },
        {
          "command": "sona.run",
          "when": "editorLangId == sona"
        },
        {
          "command": "sona.proofMode.run",
          "when": "editorLangId == sona && isWorkspaceTrusted"
        },
        {
          "command": "sona.proofMode.verifyReceipt",
          "when": "true"
        },
        {
          "command": "sona.proofMode.inspectReceipt",
          "when": "true"
        },
        {
          "command": "sona.proofMode.openReceipt",
          "when": "true"
        },
        {
          "command": "sona.proofMode.refresh",
          "when": "true"
        },
        {
          "command": "sona.proofMode.explainWithGuardian",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "sona.transpile",
          "when": "editorLangId == sona"
        },
        {
          "command": "sona.repl",
          "when": "true"
        },
        {
          "command": "sona.check",
          "when": "editorLangId == sona"
        },
        {
          "command": "sona.format",
          "when": "editorLangId == sona"
        },
        {
          "command": "sona.explain",
          "when": "editorHasSelection"
        },
        {
          "command": "sona.suggest",
          "when": "editorLangId == sona || editorLangId == python || editorLangId == javascript"
        },
        {
          "command": "sona.profile",
          "when": "editorLangId == sona"
        },
        {
          "command": "sona.benchmark",
          "when": "editorLangId == sona"
        },
        {
          "command": "sona.info",
          "when": "true"
        },
        {
          "command": "sona.help",
          "when": "true"
        },
        {
          "command": "sona.checkAIConnection",
          "when": "true"
        }
      ],
      "view/title": [
        {
          "command": "sona.runtime.refresh",
          "when": "view == sona.runtimeView",
          "group": "navigation"
        },
        {
          "command": "sona.proofMode.run",
          "when": "view == sona.proofModeExplorer && editorLangId == sona && isWorkspaceTrusted",
          "group": "navigation@1"
        },
        {
          "command": "sona.proofMode.verifyReceipt",
          "when": "view == sona.proofModeExplorer",
          "group": "navigation@2"
        },
        {
          "command": "sona.proofMode.inspectReceipt",
          "when": "view == sona.proofModeExplorer",
          "group": "navigation@3"
        },
        {
          "command": "sona.proofMode.refresh",
          "when": "view == sona.proofModeExplorer",
          "group": "navigation@4"
        },
        {
          "command": "sona.aiConsole.clear",
          "when": "view == sona.aiConsole",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "sona.proofMode.openReceipt",
          "when": "view == sona.proofModeExplorer && viewItem == sonaProofReceipt",
          "group": "inline@1"
        },
        {
          "command": "sona.proofMode.verifyReceipt",
          "when": "view == sona.proofModeExplorer && viewItem == sonaProofReceipt",
          "group": "inline@2"
        },
        {
          "command": "sona.proofMode.explainWithGuardian",
          "when": "view == sona.proofModeExplorer && viewItem == sonaProofReceipt && isWorkspaceTrusted",
          "group": "inline@3"
        }
      ],
      "editor/context": [
        {
          "submenu": "sona.contextMenu",
          "when": "editorLangId == sona",
          "group": "sona"
        }
      ],
      "sona.contextMenu": [
        { "command": "sona.guide.explainDiagnostic", "when": "editorLangId == sona", "group": "guide@1" },
        { "command": "sona.guide.explainSelection", "when": "editorLangId == sona && editorHasSelection", "group": "guide@2" },
        { "command": "sona.guide.focus", "when": "editorLangId == sona", "group": "guide@3" },
        {
          "command": "sona.run",
          "when": "editorLangId == sona",
          "group": "execution"
        },
        {
          "command": "sona.proofMode.run",
          "when": "editorLangId == sona && isWorkspaceTrusted",
          "group": "execution@2"
        },
        {
          "command": "sona.transpile",
          "when": "editorLangId == sona",
          "group": "execution"
        },
        {
          "command": "sona.check",
          "when": "editorLangId == sona",
          "group": "validation"
        },
        {
          "command": "sona.format",
          "when": "editorLangId == sona",
          "group": "validation"
        },
        {
          "command": "sona.explain",
          "when": "editorHasSelection",
          "group": "ai"
        },
        {
          "command": "sona.suggest",
          "when": "editorLangId == sona",
          "group": "ai"
        }
      ]
    },
    "submenus": [
      {
        "id": "sona.contextMenu",
        "label": "Sona AI"
      }
    ],
    "configuration": {
      "title": "Sona",
      "properties": {
        "sona.guide.mode": {
          "type": "string", "enum": ["guided", "balanced", "expert"], "default": "guided",
          "description": "Guidance detail. Explicit settings override .sona/learning.json; unset settings allow project preferences and familiarity-based scaffolding."
        },
        "sona.guide.style": {
          "type": "string", "enum": ["simple", "visual", "technical"], "default": "simple",
          "description": "Offline explanation style. Visual uses deterministic text diagrams."
        },
        "sona.guide.density": {
          "type": "string", "enum": ["focused", "normal", "complete"], "default": "normal",
          "description": "Guide Focus presentation density. The Problems list and complete JSON retain all canonical diagnostics."
        },
        "sona.guide.quiet": {
          "type": "boolean", "default": false,
          "description": "Show error-severity diagnostics in Guide Focus; preserve all diagnostics in complete JSON and the Problems list."
        },
        "sona.guide.showSetup": {
          "type": "boolean", "default": true,
          "description": "Offer an optional guidance-detail choice on first use of a Sona document."
        },
        "sona.cli.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Path to the Python executable used by the Sona CLI and language server"
        },
        "sona.cli.timeout": {
          "type": "number",
          "default": 30000,
          "description": "CLI command timeout in milliseconds"
        },
        "sona.displayPreference": {
          "type": "string",
          "enum": [
            "standard",
            "focused",
            "readable"
          ],
          "default": "standard",
          "description": "Local editor presentation preference. This is not a diagnosis and does not change Sona Guide facts.",
          "enumDescriptions": [
            "Default editor presentation",
            "Reduced visual noise and fewer interruptions",
            "More spacious text-oriented presentation"
          ]
        },
        "sona.userProfile": {
          "type": "string",
          "enum": [
            "standard",
            "focused",
            "readable"
          ],
          "default": "standard",
          "description": "Deprecated compatibility alias for sona.displayPreference. This is not a diagnosis and does not select Guide detail.",
          "deprecationMessage": "Use sona.displayPreference instead.",
          "enumDescriptions": [
            "Default editor presentation",
            "Reduced visual noise and fewer interruptions",
            "More spacious text-oriented presentation"
          ]
        },
        "sona.ai.autoSetup": {
          "type": "boolean",
          "default": true,
          "description": "Automatically prompt for AI setup when needed"
        },
        "sona.ai.defaultAgent": {
          "type": "string",
          "enum": [
            "sona",
            "qwen",
            "claude",
            "codex",
            "local"
          ],
          "default": "sona",
          "description": "Default agent selected in the Sona AI Console"
        },
        "sona.ai.qwen.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable the Qwen agent through a configured local Ollama endpoint"
        },
        "sona.ai.qwen.model": {
          "type": "string",
          "default": "qwen2.5-coder:7b",
          "description": "Ollama model used by the Qwen agent"
        },
        "sona.ai.ollama.url": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Local Ollama endpoint for configured local providers"
        },
        "sona.ai.claude.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Reserved for a future Claude provider. Credentials are not stored in plaintext settings."
        },
        "sona.ai.codex.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Reserved for a future Codex provider. The extension does not control external Codex extensions."
        },
        "sona.onboarding.showWelcome": {
          "type": "boolean",
          "default": true,
          "description": "Show welcome message and profile setup on first use"
        }
      }
    }
  },
  "activationEvents": [
    "onLanguage:sona",
    "onView:sona.proofModeExplorer",
    "onView:sona.runtimeView",
    "onView:sona.aiConsole",
    "onCommand:sona.proofMode.run",
    "onCommand:sona.runtime.refresh",
    "onCommand:sona.proofMode.verifyReceipt",
    "onCommand:sona.proofMode.inspectReceipt",
    "onCommand:sona.proofMode.openReceipt",
    "onCommand:sona.proofMode.refresh",
    "onCommand:sona.proofMode.explainWithGuardian",
    "onCommand:sona.aiConsole.focus",
    "onCommand:sona.aiConsole.clear",
    "onCommand:sona.aiConsole.selectAgent",
    "onCommand:sona.selectUserProfile",
    "onCommand:sona.welcome",
    "onStartupFinished"
  ],
  "scripts": {
    "verify:icon": "powershell -ExecutionPolicy Bypass -File scripts/verify-vsix-icon.ps1 -SkipVsix",
    "package:vsix": "npm run verify:icon && npx --no-install vsce package && powershell -ExecutionPolicy Bypass -File scripts/verify-vsix-icon.ps1",
    "vscode:prepublish": "npm run verify:icon",
    "compile": "tsc -p . && npm run bundle",
    "bundle": "esbuild src/extension.ts --bundle --minify --platform=node --format=cjs --target=node20 --supported:template-literal=false --external:vscode --outfile=out/extension.js --log-level=warning",
    "watch": "tsc -watch -p .",
    "test": "node scripts/smoke-ai-console.js",
    "test:guide": "node scripts/smoke-guide.js",
    "test:runtime": "node scripts/smoke-runtime.js"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.0"
  },
  "devDependencies": {
    "@types/node": "20.19.9",
    "@types/vscode": "1.91.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.25.8",
    "typescript": "5.7.3"
  },
  "overrides": {
    "@azure/abort-controller": "2.1.2",
    "@azure/core-auth": "1.10.1",
    "@azure/core-client": "1.10.1",
    "@azure/core-rest-pipeline": "1.22.2",
    "@azure/core-tracing": "1.3.0",
    "@azure/core-util": "1.13.0",
    "@azure/logger": "1.3.0",
    "@typespec/ts-http-runtime": "0.3.0",
    "brace-expansion": "5.0.9",
    "cheerio": "1.0.0-rc.12",
    "fast-uri": "3.1.5",
    "js-yaml": "4.3.1",
    "minimatch": "10.2.6",
    "undici": "7.29.0"
  }
}
