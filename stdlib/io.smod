const module_format = "smod-runtime"
const runtime_backend = "smod"

func input(prompt=nil) {
    return io_input(prompt)
}

func write_file(path, content) {
    return io_write_file(path, content)
}

func read_file(path) {
    return io_read_file(path)
}

func write_stdout(value=nil) {
    return io_write_stdout(value)
}

func write_stderr(value=nil) {
    return io_write_stderr(value)
}

func flush() {
    return io_flush()
}
